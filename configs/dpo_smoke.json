{
  "name": "dpo_smoke",
  "description": "DPO smoke test configuration for preference alignment.",
  "tokenizer": {
    "vocab_path": "outputs/tokenizer_full_clean/vocab.json",
    "merges_path": "outputs/tokenizer_full_clean/merge.txt",
    "special_tokens": [
      "<|endoftext|>"
    ]
  },
  "model": {
    "vocab_size": 6400,
    "context_length": 512,
    "d_model": 512,
    "num_layers": 8,
    "num_heads": 8,
    "d_ff": 1344,
    "rope_theta": 1000000.0,
    "use_rms_norm": true,
    "norm_mode": "pre",
    "ffn_type": "swiglu"
  },
  "optimizer": {
    "lr": 5e-06,
    "weight_decay": 0.1
  },
  "training": {
    "batch_size": 1,
    "max_steps": 2,
    "eval_interval": 1,
    "save_interval": 1,
    "device": "cpu",
    "seed": 42,
    "out_dir": "outputs/dpo_smoke",
    "init_checkpoint": "outputs/sft_smoke/ckpt_final.pt",
    "resume": false
  },
  "data": {
    "train_data_path": "data/dpo_smoke/train.jsonl",
    "valid_data_path": "data/dpo_smoke/valid.jsonl",
    "eos_token": "<|endoftext|>"
  },
  "lora": {
    "enabled": false,
    "r": 8,
    "alpha": 16.0,
    "targets": null
  },
  "dpo": {
    "beta": 0.1,
    "sft_weight": 0.0
  },
  "logging": {
    "wandb_project": "micro-lm",
    "run_name": "dpo_smoke",
    "mode": "disabled"
  }
}